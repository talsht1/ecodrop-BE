{
  "name": "ecodrop-api",
  "version": "1.0.0",
  "description": "Reusable recycling bin nearest-neighbor API backed by PostGIS",
  "main": "app/server.js",
  "scripts": {
    "start": "node app/server.js",
    "dev": "node --watch app/server.js",
    "test": "node --test app/tests/*.js",
    "db:local": "docker compose up -d db",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "db:seed": "node app/scripts/seed-sample-data.js"
  },
  "keywords": [
    "express",
    "postgis",
    "recycling",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.4.0",
    "pg": "^8.12.0",
    "supertest": "^7.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  }
}
